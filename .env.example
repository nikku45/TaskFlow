# ---------------------------------------------------------------------------
# TaskFlow — Environment Variables (EXAMPLE ONLY — never commit real values)
# Copy this file to .env and fill in real values for local development.
# ---------------------------------------------------------------------------

# --- App ---
NODE_ENV=development
PORT=3000
API_BASE_PATH=/api/v1

# --- PostgreSQL ---
# Full connection string used by the ORM (Prisma/TypeORM/Drizzle)
DATABASE_URL=postgresql://taskflow:taskflow_password@postgres:5432/taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_password
POSTGRES_DB=taskflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / BullMQ ---
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT / Auth ---
# Generate strong random secrets locally, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST_FACTOR=12

# --- Rate Limiting ---
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# --- Background Jobs ---
EMAIL_QUEUE_NAME=email-notifications
EMAIL_QUEUE_DLQ_NAME=email-notifications-dlq
JOB_RETRY_ATTEMPTS=3
JOB_BACKOFF_BASE_MS=1000

# --- Mock Email Provider ---
MOCK_EMAIL_FROM=noreply@taskflow.local
# Optional bonus: global email rate limit (emails/minute)
EMAIL_GLOBAL_RATE_LIMIT_PER_MIN=50

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=info

# --- Test Environment (used only when NODE_ENV=test) ---
TEST_DATABASE_URL=postgresql://taskflow:taskflow_password@postgres:5432/taskflow_test
